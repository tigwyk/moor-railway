# mooR Daemon for Railway
# Based on docker-compose.cluster.yml configuration

FROM rust:1.92-bookworm AS builder

WORKDIR /moor
RUN apt update && apt -y install clang-16 libclang-16-dev cmake libsodium-dev pkg-config git

# Copy source
COPY crates ./crates
COPY tools ./tools
COPY Cargo.toml Cargo.lock ./

# Build daemon binary
ARG BUILD_PROFILE=release-fast
RUN cargo build --profile $BUILD_PROFILE --bin moor-daemon && \
    cp target/$BUILD_PROFILE/moor-daemon /usr/local/bin/

# Runtime stage
FROM debian:bookworm-slim

RUN apt update && \
    apt -y install libssl3 libsodium23 ca-certificates git && \
    rm -rf /var/lib/apt/lists/*

# Create data directory structure
RUN mkdir -p /data/moor-data /data/cores /data/export

COPY --from=builder /usr/local/bin/moor-daemon /usr/local/bin/

# Copy fetch script for cowbell core
COPY deploy/railway/fetch-cowbell.sh /usr/local/bin/fetch-cowbell.sh
RUN chmod +x /usr/local/bin/fetch-cowbell.sh

# Create entrypoint to fetch core and start daemon
RUN printf '#!/bin/sh\n\
cd /data\n\
if [ ! -d "/data/cores/cowbell/src" ]; then\n\
  /usr/local/bin/fetch-cowbell.sh\n\
fi\n\
exec moor-daemon \\\n\
  /data/moor-data \\\n\
  --db=production.db \\\n\
  --rpc-listen=tcp://0.0.0.0:7899 \\\n\
  --events-listen=tcp://0.0.0.0:7898 \\\n\
  --workers-response-listen=tcp://0.0.0.0:7897 \\\n\
  --workers-request-listen=tcp://0.0.0.0:7896 \\\n\
  --enrollment-listen=tcp://0.0.0.0:7900 \\\n\
  --generate-keypair \\\n\
  --public-key=/data/moor.key.pub \\\n\
  --private-key=/data/moor.key.pem \\\n\
  --import=/data/cores/cowbell/src \\\n\
  --import-format=objdef \\\n\
  --export=/data/export \\\n\
  --use-boolean-returns=${USE_BOOLEAN_RETURNS:-false} \\\n\
  --custom-errors=${CUSTOM_ERRORS:-false} \\\n\
  --use-uuobjids=${USE_UUOBJIDS:-false} \\\n\
  --anonymous-objects=${ANONYMOUS_OBJECTS:-false} \\\n\
  --enable-eventlog=${ENABLE_EVENTLOG:-true}\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

# Expose ports
EXPOSE 7899 7898 7897 7896 7900

ENV RUST_BACKTRACE=1
ENV HOME=/data

ENTRYPOINT ["/entrypoint.sh"]
