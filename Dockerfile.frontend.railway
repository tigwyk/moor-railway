# Meadow Frontend for Railway
# nginx serving the Meadow web UI, proxying API calls to web-host

# Frontend build stage - build the React/TypeScript application
FROM node:20-bookworm AS build

WORKDIR /app
RUN apt update && apt -y install git

# Copy meadow client source
COPY clients/meadow/package.json clients/meadow/package-lock.json* ./clients/meadow/
WORKDIR /app/clients/meadow

# Install dependencies and build
RUN npm ci
COPY clients/meadow ./
RUN npm run build

# nginx-based frontend image
FROM nginx:alpine

# Copy built frontend assets
COPY --from=build /app/clients/meadow/dist /usr/share/nginx/html

# Copy Railway-specific nginx config that uses service discovery
COPY deploy/railway/nginx-frontend.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
