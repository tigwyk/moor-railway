# Meadow Frontend - Railway Service
FROM node:20-bookworm AS build

WORKDIR /app
RUN apt update && apt -y install git

COPY clients/meadow/package.json ./
COPY clients/meadow/package-lock.json* ./
RUN npm ci

COPY clients/meadow/ ./
RUN npm run build

FROM nginx:bookworm-slim
COPY --from=build /app/dist /usr/share/nginx/html
COPY clients/meadow/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
